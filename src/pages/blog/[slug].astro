---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { slugifyTag } from '../../utils/tags';
import { readingTime } from '../../utils/readingTime';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const published = blogPosts
    .filter((p) => p.data.published)
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  const tagSlugs = (p: (typeof blogPosts)[number]) =>
    new Set((p.data.keywords ?? []).map(slugifyTag));

  return blogPosts.map((post) => {
    const i = published.findIndex((p) => p.id === post.id);

    // Related posts: rank published posts by shared tags, newest first on ties
    const postTags = tagSlugs(post);
    const related = published
      .filter((p) => p.id !== post.id)
      .map((p) => ({ p, shared: [...tagSlugs(p)].filter((t) => postTags.has(t)).length }))
      .filter((r) => r.shared > 0)
      .sort((a, b) => b.shared - a.shared || b.p.data.date.valueOf() - a.p.data.date.valueOf())
      .slice(0, 3)
      .map((r) => r.p);

    return {
      params: { slug: post.id },
      props: {
        post,
        prev: i > 0 ? (published[i - 1] ?? null) : null,
        next: i >= 0 && i < published.length - 1 ? (published[i + 1] ?? null) : null,
        related,
      },
    };
  });
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');

// Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.photo ? `https://amirdaraee.com/${post.data.photo.replace(/\.(png|jpg|jpeg)$/, '.webp')}` : "https://amirdaraee.com/logo.webp",
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.date.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author || "Amir Daraee",
    "url": "https://amirdaraee.com"
  },
  "publisher": {
    "@type": "Person",
    "name": "Amir Daraee",
    "logo": {
      "@type": "ImageObject",
      "url": "https://amirdaraee.com/logo.webp"
    }
  },
  "keywords": post.data.keywords?.join(', ') || '',
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://amirdaraee.com/blog/${post.id}`
  }
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  author={post.data.author}
  publishedTime={post.data.date}
  {...(post.data.keywords && { tags: post.data.keywords })}
  {...(post.data.photo && { image: post.data.photo })}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12" role="article" aria-labelledby="article-title" lang={post.data.language || 'en'}>
    <div class="max-w-3xl mx-auto">
      <header class="mb-8">
        <h1 id="article-title" class="text-4xl font-bold mb-4 text-gray-900 dark:text-gray-100">{post.data.title}</h1>

        <div class="text-gray-500 dark:text-gray-400 mb-4 text-sm">
          <time datetime={post.data.date.toISOString()} aria-label={`Published on ${post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`}>
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          {' '} • {' '}
          <span aria-label="Author">By {post.data.author}</span>
          {' '} • {' '}
          <span aria-label="Estimated reading time">{minutes} min read</span>
        </div>

        {post.data.keywords && post.data.keywords.length > 0 && (
          <nav class="mb-4" aria-label="Article topics">
            <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
              {post.data.keywords.map((keyword: string) => (
                <li>
                  <a
                    href={`${base}tags/${slugifyTag(keyword)}`}
                    class="inline-block px-3 py-1 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm rounded-full hover:bg-blue-600 hover:text-white dark:hover:bg-blue-400 dark:hover:text-gray-900 transition-colors duration-200"
                  >{keyword}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {post.data.photo && (
          <figure class="mb-4">
            <picture>
              <source srcset={`${base}${post.data.photo.replace(/^\//, '').replace(/\.(png|jpg|jpeg)$/, '.webp')}`} type="image/webp">
              <img
                src={`${base}${post.data.photo.replace(/^\//, '')}`}
                alt={`Featured image for ${post.data.title}`}
                class="w-full h-auto rounded-lg"
                loading="eager"
                width="800"
                height="533"
              />
            </picture>
            {post.data.imgCredit && (
              <figcaption class="text-gray-500 dark:text-gray-400 mt-2 text-sm">
                Image credit: {post.data.imgCredit}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      <div class="prose dark:prose-invert" role="main" id="main-content">
        <Content />
      </div>

      <hr class="my-10 border-gray-300 dark:border-gray-700" role="separator" />

      {related.length > 0 && (
        <section class="mb-10" aria-labelledby="related-posts-heading">
          <h2 id="related-posts-heading" class="text-2xl font-semibold mb-4 text-gray-900 dark:text-gray-100">Related posts</h2>
          <ul class="space-y-3 list-none p-0 m-0">
            {related.map((r) => (
              <li>
                <a href={`${base}blog/${r.id}`} class="text-blue-600 dark:text-blue-400 hover:underline font-medium">{r.data.title}</a>
                <time datetime={r.data.date.toISOString()} class="text-gray-500 dark:text-gray-400 text-sm ml-2">
                  {r.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </li>
            ))}
          </ul>
        </section>
      )}

      <nav aria-label="Post navigation" class="space-y-6">
        {(prev || next) && (
          <div class="flex justify-between gap-4 text-sm">
            {prev ? (
              <a href={`${base}blog/${prev.id}`} class="text-blue-600 dark:text-blue-400 hover:underline max-w-[45%]" rel="prev">
                ← {prev.data.title}
              </a>
            ) : <span />}
            {next ? (
              <a href={`${base}blog/${next.id}`} class="text-blue-600 dark:text-blue-400 hover:underline max-w-[45%] text-right" rel="next">
                {next.data.title} →
              </a>
            ) : <span />}
          </div>
        )}
        <div class="text-center">
          <a
            href={`${base}blog`}
            class="inline-block px-6 py-3 border-2 border-blue-600 dark:border-blue-400 text-blue-600 dark:text-blue-400 rounded-md hover:bg-blue-600 hover:text-white dark:hover:bg-blue-400 dark:hover:text-gray-900 transition-colors duration-200"
            aria-label="Return to blog post listing"
          >
            ← Back to Blog
          </a>
        </div>
      </nav>
    </div>
  </article>
</Layout>

<script>
  // Fire a single read_complete event when the reader reaches the end of the
  // article body. reading_seconds approximates time actually spent on the page.
  const articleBody = document.getElementById('main-content');
  if (articleBody && 'IntersectionObserver' in window) {
    const start = Date.now();
    const wordCount = (articleBody.textContent ?? '').trim().split(/\s+/).length;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        observer.disconnect();
        (window as any).gtag?.('event', 'read_complete', {
          reading_seconds: Math.round((Date.now() - start) / 1000),
          word_count: wordCount,
        });
      }
    });
    const sentinel = document.createElement('span');
    articleBody.appendChild(sentinel);
    observer.observe(sentinel);
  }
</script>

<script>
  // Add a copy-to-clipboard button to every code block
  const svg = (path: string) =>
    `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${path}</svg>`;
  const copyIcon = svg('<rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>');
  const checkIcon = svg('<path d="M20 6 9 17l-5-5"/>');
  const failIcon = svg('<path d="M18 6 6 18M6 6l12 12"/>');

  document.querySelectorAll('pre.astro-code').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy-btn';
    btn.innerHTML = copyIcon;
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    btn.title = 'Copy code';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.innerHTML = checkIcon;
        btn.classList.add('copied');
      } catch {
        btn.innerHTML = failIcon;
        btn.classList.add('failed');
      }
      setTimeout(() => {
        btn.innerHTML = copyIcon;
        btn.classList.remove('copied', 'failed');
      }, 2000);
    });
    pre.appendChild(btn);
  });
</script>

<style is:global>
  .prose {
    max-width: 100%;
    line-height: 1.8;
    color: #374151;
  }

  .dark .prose {
    color: #d1d5db;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
    color: #1f2937;
  }

  .dark .prose h1,
  .dark .prose h2,
  .dark .prose h3,
  .dark .prose h4,
  .dark .prose h5,
  .dark .prose h6 {
    color: #f3f4f6;
  }

  .prose h1 {
    font-size: 2rem;
  }

  .prose h2 {
    font-size: 1.5rem;
  }

  .prose h3 {
    font-size: 1.25rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose a {
    color: #007bff;
    text-decoration: none;
  }

  .dark .prose a {
    color: #60a5fa;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .prose pre {
    position: relative;
    background-color: #2d2d2d;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .code-copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border-radius: 0.375rem;
    border: 1px solid #d1d5db;
    background-color: rgba(255, 255, 255, 0.9);
    color: #374151;
    cursor: pointer;
    transition: color 0.15s;
  }

  .code-copy-btn.copied {
    color: #059669;
  }

  .code-copy-btn.failed {
    color: #dc2626;
  }

  .dark .code-copy-btn {
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(31, 41, 55, 0.9);
    color: #d1d5db;
  }

  .dark .code-copy-btn.copied {
    color: #34d399;
  }

  .dark .code-copy-btn.failed {
    color: #f87171;
  }

  .dark .prose pre {
    background-color: #1f2937;
  }

  .prose code {
    background-color: #f4f4f4;
    color: #1f2937;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .dark .prose code {
    background-color: #374151;
    color: #e5e7eb;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: #f8f8f2;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 4px solid #ddd;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #666;
    font-style: italic;
  }

  .dark .prose blockquote {
    border-left-color: #4b5563;
    color: #9ca3af;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }

  .prose th,
  .prose td {
    border: 1px solid #ddd;
    padding: 0.75rem;
    text-align: left;
  }

  .dark .prose th,
  .dark .prose td {
    border-color: #4b5563;
  }

  .prose th {
    background-color: #f4f4f4;
    font-weight: 600;
  }

  .dark .prose th {
    background-color: #374151;
  }

  /* Print styles for better PDF export and printing */
  @media print {
    body {
      background: white !important;
      color: black !important;
    }

    article {
      max-width: 100% !important;
      padding: 0 !important;
    }

    .prose {
      color: black !important;
    }

    .prose h1,
    .prose h2,
    .prose h3,
    .prose h4,
    .prose h5,
    .prose h6 {
      color: black !important;
      page-break-after: avoid;
    }

    .prose a {
      color: #0066cc !important;
      text-decoration: underline;
    }

    .prose a[href]:after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      font-weight: normal;
    }

    .prose pre,
    .prose code {
      background-color: #f5f5f5 !important;
      color: black !important;
      border: 1px solid #ddd;
    }

    .prose img {
      max-width: 100% !important;
      page-break-inside: avoid;
    }

    .prose table {
      page-break-inside: avoid;
    }

    /* Hide navigation elements when printing */
    nav[aria-label="Post navigation"],
    header > nav,
    footer,
    .code-copy-btn {
      display: none !important;
    }

    hr {
      border-color: #999 !important;
    }
  }
</style>
